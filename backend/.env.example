# Copy this file to .env and fill in your real key. NEVER commit .env.
ANTHROPIC_API_KEY=your-key-here

# Optional overrides
MODEL=claude-sonnet-4-6
RATE_LIMIT_PER_MINUTE=10        # per client IP; 0 disables
MAX_INPUT_CHARS=30000
ALLOWED_ORIGINS=*               # comma-separated, e.g. https://your-frontend.example
LOG_LEVEL=INFO
